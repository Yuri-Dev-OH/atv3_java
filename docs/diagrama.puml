@startuml
title AutoBots - atualização de base (ATVIII)
hide empty members

enum PerfilUsuario { CLIENTE\nFUNCIONARIO\nFORNECEDOR }
enum TipoDocumento { CPF\nCNPJ\nRG\nCNH\nPASSAPORTE\nOUTRO }
enum TipoVeiculo { HATCH\nSEDA\nSUV\nPICKUP\nSW }

interface Titular {
  Endereco getEndereco()
  List<Telefone> getTelefones()
}
class Empresa {
  Long id
  String razaoSocial
  String nomeFantasia
  Instant cadastro
}
class Usuario {
  Long id
  String nome
  String nomeSocial
  LocalDate dataNascimento
  Instant dataCadastro
  Set<PerfilUsuario> perfis
}
class Endereco {
  Long id
  String estado
  String cidade
  String bairro
  String rua
  String numero
  String codigoPostal
  String informacoesAdicionais
}
class Telefone {
  Long id
  String ddd
  String numero
}
class Documento {
  Long id
  TipoDocumento tipo
  String numero
  LocalDate dataEmissao
}
class Email {
  Long id
  String endereco
}
abstract class Credencial {
  Long id
  Instant criacao
  Instant ultimoAcesso
  boolean inativo
}
class CredencialUsuarioSenha {
  String nomeUsuario
  String senha <<hash PBKDF2>>
}
class CredencialCodigoBarra {
  Long codigo
}
class Veiculo {
  Long id
  TipoVeiculo tipo
  String modelo
  String placa
}
class Mercadoria {
  Long id
  String nome
  String descricao
  LocalDate fabricacao
  LocalDate validade
  Instant cadastro
  long quantidade
  BigDecimal valor
}
class Servico {
  Long id
  String nome
  String descricao
  BigDecimal valor
}
class Venda {
  Long id
  String identificacao
  Instant cadastro
}
class ItemMercadoria <<embeddable>> {
  String nome
  int quantidade
  BigDecimal valorUnitario
}
class ItemServico <<embeddable>> {
  String nome
  int quantidade
  BigDecimal valorUnitario
}

Titular <|.. Empresa
Titular <|.. Usuario
Credencial <|-- CredencialUsuarioSenha
Credencial <|-- CredencialCodigoBarra

Empresa "1" *-- "0..1" Endereco
Empresa "1" *-- "0..*" Telefone
Empresa "1" o-- "0..*" Usuario : usuarios
Empresa "1" o-- "0..*" Mercadoria : estoque
Empresa "1" o-- "0..*" Servico : catálogo
Empresa "1" o-- "0..*" Venda

Usuario "1" *-- "0..1" Endereco
Usuario "1" *-- "0..*" Telefone
Usuario "1" *-- "0..*" Documento
Usuario "1" *-- "0..*" Email
Usuario "1" *-- "0..*" Credencial
Usuario "1" *-- "0..*" Veiculo : proprietario (CLIENTE)
Usuario "0..1" -- "0..*" Mercadoria : fornecedor (FORNECEDOR)

Venda "0..*" --> "1" Usuario : cliente (CLIENTE)
Venda "0..*" --> "1" Usuario : funcionario (FUNCIONARIO)
Venda "0..*" --> "0..1" Veiculo
Venda "1" *-- "0..*" ItemMercadoria
Venda "1" *-- "0..*" ItemServico
ItemMercadoria "0..*" --> "1" Mercadoria
ItemServico "0..*" --> "1" Servico

package "API (RMM nível 3)" {
  class RaizControle
  class EmpresaControle
  class UsuarioControle
  class "EmpresaEnderecoControle\nUsuarioEnderecoControle" as EnderecoControles
  class "EmpresaTelefoneControle\nUsuarioTelefoneControle" as TelefoneControles
  class "DocumentoControle\nEmailControle\nCredencialControle\nVeiculoControle" as SubrecursoControles
  class "MercadoriaControle\nServicoControle\nVendaControle" as LojaControles
  class "AdicionadorLink*" as AdicionadoresLink
  class HipermidiaConfiguracao
  class TratadorErros
}
RaizControle ..> EmpresaControle : link empresas
EmpresaControle ..> AdicionadoresLink
UsuarioControle ..> AdicionadoresLink
LojaControles ..> AdicionadoresLink
@enduml
